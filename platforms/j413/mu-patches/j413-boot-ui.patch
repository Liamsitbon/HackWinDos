+  }
+  J413UsbInventory();
+  J413Checkpoint("USB boot connection result", Status);
+  mSetupSelected = TRUE;
+  Status = J413WaitForBootOption(Option);
+  J413Checkpoint("Fixed-volume ARM64 selection result", Status);
+  if (EFI_ERROR(Status) && gST->ConOut != NULL) {
+    J413ShowUsbFailure(Status);
+  }
+  return Status;
