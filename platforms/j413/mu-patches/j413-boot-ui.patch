+STATIC EFI_STATUS EFIAPI GetJ413SetupOption(OUT EFI_BOOT_MANAGER_LOAD_OPTION *Option)
+{
+  EFI_STATUS Status;
+  if (Option == NULL) return EFI_INVALID_PARAMETER;
+  if (mSetupSelected) return J413NextDirectSetupOption(Option);
+  // Called by BDS at TPL_APPLICATION, never from a notification callback.
+  J413LogStatus("J413 EFI phase log; not complete UART/kernel log", EFI_SUCCESS);
