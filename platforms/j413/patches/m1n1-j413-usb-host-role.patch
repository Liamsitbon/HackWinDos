diff --git a/src/usb.c b/src/usb.c
index e9035beb..f6b00c2a 100644
--- a/src/usb.c
+++ b/src/usb.c
@@ -38,6 +38,8 @@ struct usb_drd_regs {
 static tps6598x_irq_state_t tps6598x_irq_state[USB_IODEV_COUNT];
 static bool usb_is_initialized = false;
 
+#define USB2PHY_SIG_HOST (7U << 12)
+
 #define PIPEHANDLER_MUX_CTRL             0x0c
 #define PIPEHANDLER_MUX_CTRL_USB3        0x08
 #define PIPEHANDLER_MUX_CTRL_USB4_TUNNEL 0x11
@@ -140,7 +142,15 @@ int usb_phy_bringup(u32 idx)
     if (pmgr_adt_power_enable(path) < 0)
         return -1;
 
-    write32(usb_regs.atc + 0x08, 0x01c1000f);
+    u32 phy_signal = 0x01c1000f;
+#if defined(M1N1_J413) && defined(M1N1_NO_PROXY)
+    /* USB1 is owned by the preboot xHCI host in this profile. The external
+     * USB2 PHY role must agree before its existing reset/power sequence.
+     * USB0 and proxy/legacy builds retain their original PHY configuration. */
+    if (idx == 1)
+        phy_signal |= USB2PHY_SIG_HOST;
+#endif
+    write32(usb_regs.atc + 0x08, phy_signal);
     write32(usb_regs.atc + 0x04, 0x00000003);
     write32(usb_regs.atc + 0x04, 0x00000000);
     write32(usb_regs.atc + 0x1c, 0x008c0813);
@@ -150,6 +160,14 @@ int usb_phy_bringup(u32 idx)
     write32(usb_regs.drd_regs_unk3 + PIPEHANDLER_AON_GEN, PIPEHANDLER_AON_GEN_DWC3_RESET_N);
     write32(usb_regs.drd_regs_unk3 + PIPEHANDLER_NONSELECTED_OVERRIDE, 0x9332);
 
+#if defined(M1N1_J413) && defined(M1N1_NO_PROXY)
+    if (idx == 1) {
+        u32 actual = read32(usb_regs.atc + 0x08);
+        printf("USB1: preboot host PHY SIG requested=%#x readback=%#x\n", phy_signal, actual);
+        if ((actual & USB2PHY_SIG_HOST) != USB2PHY_SIG_HOST)
+            return -1;
+    }
+#endif
     return 0;
 }
 
